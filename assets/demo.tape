# records assets/demo.gif from the --demo server: vhs assets/demo.tape
Output assets/demo.gif

Set Shell bash
Set FontSize 16
Set Width 1400
Set Height 760
Set Padding 20
Set Theme "Catppuccin Mocha"

Type "slotwatch --demo"
Sleep 500ms
Enter
Sleep 3s

Down
Sleep 1.5s
Down
Sleep 1.5s
Up
Sleep 1.5s
Up
Sleep 2s

Ctrl+D
Sleep 1.5s
Ctrl+U
Sleep 1.5s

Type "s"
Sleep 2s
Type "s"
Sleep 2s

Type "/debezium"
Sleep 2.5s
Escape
Sleep 2s

Type "q"
